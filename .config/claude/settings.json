{
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Bash(ls:*)",
      "Bash(bash -n:*)",
      "Bash(zsh:*)",
      "Bash(echo:*)",
      "Bash(gh api *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comments *)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
  "Stop": [
    { "hooks": [{ "type": "command", "command": "afplay /System/Library/Sounds/Glass.aiff" }] }
  ]
},
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest"
  },
  "preferences": {
    "custom_instructions": "If a new feature is implemented, always end the response with: what features were added, how to test them, and the expected output."
  }
}
